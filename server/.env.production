# Production Environment Variables Template
# Copy these to your hosting platform's environment settings

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/student-collaboration-hub?retryWrites=true&w=majority

# JWT Configuration (Generate a strong secret)
JWT_SECRET=your_super_secure_production_jwt_secret_key_here_minimum_32_characters

# Optional: Additional Production Settings
FRONTEND_URL=https://your-frontend-domain.netlify.app
